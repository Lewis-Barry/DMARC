{
  "manifest_version": 3,
  "name": "Sendmaster",
  "version": "0.1.0",
  "description": "Shows SPF, DKIM, and DMARC records for the current site.",
  "action": {
    "default_title": "Sendmaster",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "https://cloudflare-dns.com/*",
    "https://dns.google/*"
  ]
}